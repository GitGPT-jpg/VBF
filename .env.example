# ── App ──────────────────────────────────────────────
# development | production (production enforces security checks)
APP_ENV=development
WEB_SECRET_KEY=change-me-to-a-long-random-string
WEB_PORT=5000
LOG_LEVEL=INFO

# ── Database (defaults to data/app.db) ───────────────
DATABASE_URL=

# ── LLM ──────────────────────────────────────────────
# Provider: anthropic (default) | openai | deepseek
LLM_PROVIDER=anthropic
# -- Anthropic (Claude) --
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# -- OpenAI-compatible (OpenAI / DeepSeek / local) --
# For DeepSeek: LLM_PROVIDER=deepseek, OPENAI_BASE_URL=https://api.deepseek.com,
#               OPENAI_MODEL=deepseek-chat, OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── TTS / Voice ──────────────────────────────────────
# edge | elevenlabs | fish
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# ── Singing (Replicate cloud RVC) ────────────────────
REPLICATE_API_KEY=

# ── Feature flags ────────────────────────────────────
ENABLE_SINGING=true
ENABLE_MEMORY_EXTRACTION=true
ENABLE_STREAMING=true

# ── Bootstrap accounts (migrated into DB on first run;
#    change these before any real deployment!) ────────
WEB_USER=admin
WEB_PASS=admin
WEB_GF_USER=girl
WEB_GF_PASS=girl
